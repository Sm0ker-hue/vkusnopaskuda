# Backend Environment Configuration
ENVIRONMENT=production
PORT=8000
SECRET_KEY=generate_a_secure_random_key_here

# PostgreSQL Database (Neon or managed Postgres)
DATABASE_URL=postgresql+asyncpg://username:password@ep-host.eu-central-1.aws.neon.tech/neondb?ssl=require

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://vkusnopaskuda.app
